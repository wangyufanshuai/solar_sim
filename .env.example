# Public asset base for large models/textures served from OSS.
# Leave empty for local public/ assets during development.
# Production uses the same-origin Nginx OSS proxy to avoid WebGL CORS issues.
# NEXT_PUBLIC_SOLAR_ASSET_BASE=/solar-assets/solar

# WebSocket endpoints. In production the app can infer these from the current host.
# NEXT_PUBLIC_SIM_WS_URL=wss://solar.wangyufan.xyz/ws/sim
# NEXT_PUBLIC_LAUNCH_WS_URL=wss://solar.wangyufan.xyz/ws/launch

# Set to 1 to use legacy fixed-substep RK4 instead of adaptive Dormand-Prince 5(4).
# NEXT_PUBLIC_SOLAR_FIXED_RK4=1

# Optional equirect sky (JPG/PNG). Overrides default sky candidates.
# NEXT_PUBLIC_SKY_EQUIRECT_URL=/textures/sky/eso0932a.png

# Equirect sky brightness. IBL is capped low in code.
# NEXT_PUBLIC_SKY_EQUIRECT_EXPOSURE=0.09

# Planet texture base. Defaults to `${NEXT_PUBLIC_SOLAR_ASSET_BASE}/textures/planets`
# when `NEXT_PUBLIC_SOLAR_ASSET_BASE` is set; otherwise `/textures/planets`.
# NEXT_PUBLIC_PLANET_TEXTURE_BASE=/textures/planets

# Screen-space ambient occlusion. Default off; enabling without tuning can black out the viewport.
# NEXT_PUBLIC_ENABLE_SSAO=1

# LightBender: exaggerated gravitational lens on the far-depth background.
# NEXT_PUBLIC_LENSING_ENABLED=1
# NEXT_PUBLIC_LENSING_STRENGTH=1
# NEXT_PUBLIC_LENSING_STEPS=10
# NEXT_PUBLIC_LENSING_UV_SCALE=5
# NEXT_PUBLIC_LENSING_QUALITY=medium
