    { "id": "black-eye-galaxy", "category": "galaxy", "query": "Black Eye Galaxy M64", "requiredTermGroups": [["black eye", "m64"], ["galaxy"]] },
    { "id": "sunflower-galaxy", "category": "galaxy", "query": "Sunflower Galaxy M63", "requiredTermGroups": [["sunflower", "m63"], ["galaxy"]] },

