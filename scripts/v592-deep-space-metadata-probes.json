    { "id": "messier-3", "category": "cluster", "query": "Messier 3 globular cluster", "supplementalQuery": "M3 globular", "requiredTermGroups": [["messier 3", "m3", "ngc 5272"], ["cluster"]] },
    { "id": "messier-5", "category": "cluster", "query": "Messier 5 globular cluster", "requiredTermGroups": [["messier 5", "m5", "ngc 5904"], ["cluster"]] },
