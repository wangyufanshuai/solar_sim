    { "id": "rhea", "query": "Rhea Saturn moon global map", "requiredTerms": ["rhea"] },
    { "id": "iapetus", "query": "Iapetus Saturn moon global map", "requiredTerms": ["iapetus"] },
    { "id": "triton", "query": "Triton Neptune moon global map", "requiredTerms": ["triton"] },
    { "id": "miranda", "query": "Miranda Uranus moon global map", "requiredTerms": ["miranda"] },
