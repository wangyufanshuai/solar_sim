# WebSocket to viz_server (Next dev rewrites do not upgrade WebSocket).
# Default in code can point here when you add client-side sim wiring.
NEXT_PUBLIC_SIM_WS_URL=ws://127.0.0.1:8765/ws/sim

# Set to 1 to use legacy fixed-substep RK4 instead of adaptive Dormand–Prince 5(4).
# NEXT_PUBLIC_SOLAR_FIXED_RK4=1

# Optional equirect sky (JPG/PNG). Overrides default `/textures/sky/eso0932a.jpg`.
# See public/textures/sky/README.md.
# NEXT_PUBLIC_SKY_EQUIRECT_URL=/textures/sky/eso0932a.jpg

# Equirect sky brightness (planetarium-dark default ~0.07 if unset). IBL capped low in code.
# NEXT_PUBLIC_SKY_EQUIRECT_EXPOSURE=0.09

# Screen-space ambient occlusion (postprocessing). Default off — enabling without tuning can black out the viewport at solar-system scale.
# NEXT_PUBLIC_ENABLE_SSAO=1

# LightBender: exaggerated gravitational lens on the far-depth background (not physical scale).
# NEXT_PUBLIC_LENSING_ENABLED=1
# NEXT_PUBLIC_LENSING_STRENGTH=1
# NEXT_PUBLIC_LENSING_STEPS=10
# NEXT_PUBLIC_LENSING_UV_SCALE=5
# Quality: high (default) | medium | low — caps bodies/steps, disables arc taps on low.
# NEXT_PUBLIC_LENSING_QUALITY=medium
