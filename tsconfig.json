{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next*/types/**/*.ts",
    ".next*/dev/types/**/*.ts",
    ".next-v192/types/**/*.ts",
    ".next-v192/dev/types/**/*.ts",
    ".next-v192-lite/types/**/*.ts",
    ".next-v192-lite/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-v200/types/**/*.ts",
    ".next-v200/dev/types/**/*.ts",
    ".next-v200-lite/types/**/*.ts",
    ".next-v200-lite/dev/types/**/*.ts",
    ".next-v216/types/**/*.ts",
    ".next-v216/dev/types/**/*.ts",
    ".next-v216-lite/types/**/*.ts",
    ".next-v216-lite/dev/types/**/*.ts",
    ".next-v224/types/**/*.ts",
    ".next-v224/dev/types/**/*.ts",
    ".next-v224-lite/types/**/*.ts",
    ".next-v224-lite/dev/types/**/*.ts",
    ".next-atlas-standalone-current/types/**/*.ts",
    ".next-atlas-standalone-current/dev/types/**/*.ts",
    ".next-atlas-lite-current/types/**/*.ts",
    ".next-atlas-lite-current/dev/types/**/*.ts",
    ".next-atlas-local-shadow-current/types/**/*.ts",
    ".next-atlas-local-shadow-current/dev/types/**/*.ts",
    ".next-v589-dev/types/**/*.ts",
    ".next-v589-dev/dev/types/**/*.ts",
    ".next-atlas-v592-dev/types/**/*.ts",
    ".next-atlas-v592-dev/dev/types/**/*.ts",
    ".next-atlas-v592-visual-qa/types/**/*.ts",
    ".next-atlas-v592-visual-qa/dev/types/**/*.ts",
    ".next-atlas-v593-dev-current/types/**/*.ts",
    ".next-atlas-v593-dev-current/dev/types/**/*.ts",
    ".next-atlas-v594-dev-diagnostic/types/**/*.ts",
    ".next-atlas-v594-dev-diagnostic/dev/types/**/*.ts",
    ".next-retention-inspect/types/**/*.ts",
    ".next-retention-inspect/dev/types/**/*.ts",
    ".next-v596-dev/types/**/*.ts",
    ".next-v596-dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
